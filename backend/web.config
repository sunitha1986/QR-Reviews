<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />

    <!-- Node.js handler -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Rewrite rules -->
    <rewrite>
      <rules>
        <!-- 1. Allow static uploads (do not rewrite) -->
        <rule name="StaticUploads" stopProcessing="true">
          <match url="^uploads/(.*)$" />
          <action type="None" />
        </rule>

        <!-- 2. Serve static frontend files from Vite dist directory -->
        <rule name="DistFiles" stopProcessing="true">
          <match url="^(?!api(?:/|$))(?!dist/)(.*)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}dist\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="dist/{R:1}" />
        </rule>

        <!-- 3. Serve static frontend files from build directory (if deployed as build) -->
        <rule name="BuildFiles" stopProcessing="true">
          <match url="^(?!api(?:/|$))(?!build/)(.*)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}build\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="build/{R:1}" />
        </rule>

        <!-- 4. Send API requests directly to Node.js / server.js -->
        <rule name="NodeAPI" stopProcessing="true">
          <match url="^/*api(?:/.*)?$" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <!-- 5. Route SPA frontend paths to dist/index.html if exists -->
        <rule name="FrontendRoutesDist" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}dist\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="dist/index.html" />
        </rule>

        <!-- 6. Route SPA frontend paths to build/index.html as fallback -->
        <rule name="FrontendRoutesBuild" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="build/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- iisnode configuration: enable logging, dev errors, and configure named pipe retries -->
    <iisnode
      loggingEnabled="true"
      devErrorsEnabled="true"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      node_env="production"
    />

  </system.webServer>
</configuration>
