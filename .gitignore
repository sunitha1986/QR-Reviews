# =========================================================================
# QR Reviews Project - Git Ignore
# =========================================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (Prevent credential leaks)
.env
.env.*
backend/.env
frontend/.env
*.env
*.env.local
*.env.production
!.env.example
!backend/.env.example
!*.env.example

# Build & Distribution Artifacts
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Scratch Files
*.tmp
*.temp
scratch/

# Generated Review Exports
backend/data/*.xlsx
